<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.pakslab.keep-mac-awake.helper</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/ai.pakslab.keep-mac-awake.helper</string>
  <key>MachServices</key>
  <dict>
    <key>ai.pakslab.keep-mac-awake.helper</key>
    <true/>
  </dict>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>ai.pakslab.keep-mac-awake</string>
  </array>
  <!-- The helper enforces the user's switches against anything else that writes
       the power settings, so it has to be running rather than started on demand.
       On demand would mean the rule lapses at every reboot until the app is
       opened — and the app is not required to run. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
